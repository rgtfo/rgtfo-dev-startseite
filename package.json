{
  "name": "rg-startseite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:js": "terser src/script.js -o dist/script.js -c -m",
    "build:css": "cleancss -o dist/style.css src/style.css",
    "build:html": "html-minifier-terser --collapse-whitespace --remove-comments --minify-css true --minify-js true src/index.html -o dist/index.html",
    "build:assets": "copyfiles -u 1 assets/**/* dist",
    "build": "rimraf dist && npx mkdirp dist && npm run build:js && npm run build:css && npm run build:html && npm run build:assets"
  },
  "keywords": [],
  "author": "David Righi",
  "license": "CC BY-NC",
  "type": "commonjs",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "copyfiles": "^2.4.1",
    "html-minifier-terser": "^7.2.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^5.0.10",
    "terser": "^5.44.0"
  }
}
